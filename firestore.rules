rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Action: Update profile/stats
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'coins', 'stars', 'lastLogin'])
      );

      function isValidUser(data) {
        return data.uid == request.auth.uid &&
               data.displayName is string && data.displayName.size() <= 100 &&
               (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500)) &&
               data.coins is number && data.coins >= 0 &&
               data.stars is number && data.stars >= 0;
      }
    }

    // --- Leaderboard ---
    match /leaderboard/{scoreId} {
      allow list: if isSignedIn() && request.query.limit <= 100;
      allow get: if isSignedIn();
      allow create: if isSignedIn() && incoming().uid == request.auth.uid && isValidScore(incoming());
      
      function isValidScore(data) {
        return data.score is number && data.score >= 0 &&
               data.mode in ['classic', 'timed', 'daily', 'relax', 'kids'] &&
               data.displayName is string && data.displayName.size() <= 100 &&
               data.timestamp == request.time;
      }
    }

    // --- Achievements ---
    match /users/{userId}/achievements/{achId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidAchievement(incoming());

      function isValidAchievement(data) {
        return data.uid == request.auth.uid &&
               data.badgeId is string && data.badgeId.size() <= 50 &&
               data.earnedAt == request.time;
      }
    }
  }
}
